# Unity .gitignore - sensible defaults for most Unity projects
# Keep project source files and intentionally-checked-in assets, ignore generated, user-specific, and OS/IDE files

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# Autogenerated by Unity (cache, shader compiler, etc.)
sysinfo.txt

# User-specific settings
UserSettings/
*.csproj.user
*.suo
*.user
*.userprefs
*.pidb
*.pidb.meta
*.booproj
*.svd
*.opendb
*.VC.db

# VS / Rider / IDE
.vs/
.vscode/
.idea/
*.sln.DotSettings
*.resharper
_ReSharper*/
*.DotSettings.user

# OS generated
.DS_Store
Thumbs.db
.desktop

# Node / package managers
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Logs and crash reports
*.log
crash.log

# Build outputs
*.apk
*.aab
*.xcodeproj
*.xcworkspace
*.xcuserdata/
*.app
*.exe
*.dll
*.so
*.dylib
*.zip
*.tar.gz
*.unitypackage

# Don't ignore project/solution files by default (they are present in this repo)
# If you want to ignore generated project files, uncomment the following lines:
# *.csproj
# *.sln

# Gradle / Android build
.gradle/
build/
**/build/

# Temporary or cache files
*.tmp
*.temp
*.bak
*.orig
*.swp

# Editor specific cache
MemoryCaptures/

# Prevent checking in local secrets or credentials
.env

# JetBrains Rider caches
.idea/
*.sln.iml

# Other
/Assets/Pixel Crushers/
/Assets/Plugins/
/Assets/SensorToolkit/
/Assets/TopDownEngine/
/Assets/TextMesh Pro/
/Assets/ConsolePro/
/Assets/_Recovery/
/Packages/

/graphify-out/
.codex/skills/graphify/
Assets/graphify-out/
