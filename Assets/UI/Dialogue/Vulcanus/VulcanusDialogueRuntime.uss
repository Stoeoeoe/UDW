.dialogue-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-font: url("../../Fonts/Jersey25-Regular.ttf");
    -unity-font-definition: initial;
}

.dialogue-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.388);
}

.dialogue-anchor {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: center;
    padding: 24px;
}

.dialogue-anchor.is-top {
    justify-content: flex-start;
}

.dialogue-shell {
    width: 560px;
    max-width: 100%;
    flex-shrink: 0;
}

/* A basic box: the speaker's portrait and name on the left, the line or choices on the right.
   With a speaker the box keeps the portrait's height, so it does not grow while the text is revealed. */
.dialogue-panel {
    flex-direction: row;
    min-height: 144px;
    padding: 24px;
    flex-shrink: 0;
    background-image: url("../../UIBox01.png");
    -unity-slice-scale: 0.32;
}

.dialogue-panel.has-speaker {
    min-height: 192px;
}

.dialogue-speaker-column {
    display: none;
    flex-shrink: 0;
    margin-right: 16px;
    align-items: center;
}

.dialogue-panel.has-speaker .dialogue-speaker-column {
    display: flex;
}

.dialogue-content {
    flex-grow: 1;
    flex-shrink: 1;
    max-height: 360px;
}

.dialogue-body {
    color: rgb(84, 30, 4);
    font-size: 22px;
    white-space: normal;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: upper-left;
}

/* The frame carries the border, so the portrait inside it is exactly the size the presenter gives it. */
.dialogue-portrait-frame {
    flex-shrink: 0;
    border-width: 2px;
    border-color: rgb(119, 65, 31);
    background-color: rgba(84, 30, 4, 0.25);
}

.dialogue-portrait {
    width: 104px;
    height: 104px;
    -unity-background-scale-mode: scale-to-fit;
}

.dialogue-portrait.is-empty {
    background-image: none;
}

.dialogue-speaker {
    align-self: stretch;
    margin: 6px 0 0 0;
    padding: 0;
    color: rgb(84, 30, 4);
    font-size: 22px;
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dialogue-choices {
    flex-shrink: 0;
}

.dialogue-choice {
    min-height: 32px;
    margin: 6px 4px 0 0;
    padding: 4px 8px;
    white-space: normal;
    font-size: 20px;
    color: rgb(84, 30, 4);
    -unity-text-align: middle-left;
    background-color: rgb(244, 188, 104);
    border-width: 2px;
    border-color: rgb(119, 65, 31);
    border-radius: 0;
}

.dialogue-choice:hover, .dialogue-choice:focus {
    background-color: rgb(255, 211, 139);
    border-color: rgb(79, 39, 19);
}

.dialogue-choice:active {
    background-color: rgb(216, 145, 76);
}

.dialogue-content .unity-scroller--vertical {
    width: 10px;
}

.dialogue-content .unity-base-slider__tracker {
    background-color: rgb(151, 94, 48);
    border-radius: 0;
}

.dialogue-content .unity-base-slider__dragger {
    background-color: rgb(238, 177, 94);
    border-width: 1px;
    border-color: rgb(84, 30, 4);
    border-radius: 0;
}

.dialogue-footer {
    height: 40px;
    min-height: 40px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.dialogue-hint {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 8px 0 0;
    color: rgb(246, 221, 175);
    font-size: 18px;
    white-space: normal;
}

.dialogue-button {
    min-width: 96px;
    height: 36px;
    flex-shrink: 0;
    margin: 0;
    padding: 2px 12px;
    font-size: 20px;
    color: rgb(84, 30, 4);
    background-color: rgb(244, 188, 104);
    border-width: 2px;
    border-color: rgb(119, 65, 31);
    border-radius: 0;
}

.dialogue-button:hover, .dialogue-button:focus {
    background-color: rgb(255, 211, 139);
    border-color: rgb(79, 39, 19);
}

.dialogue-button:active {
    background-color: rgb(216, 145, 76);
}
