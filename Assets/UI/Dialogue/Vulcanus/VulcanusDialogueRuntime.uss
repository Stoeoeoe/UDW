.dialogue-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-font: url("../../Fonts/Jersey25-Regular.ttf");
    -unity-font-definition: initial;
}

.dialogue-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.388);
}

.dialogue-anchor {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: center;
    padding: 24px;
}

.dialogue-shell {
    width: 560px;
    max-width: 100%;
    flex-shrink: 0;
}

/* The original artwork includes the text frame, portrait frame and nameplate.
   Keep its proportions and reserve the whole frame while the text is revealed. */
.dialogue-panel {
    position: relative;
    height: 222px;
    min-height: 222px;
    flex-shrink: 0;
    background-image: url("../in progress dialogue box.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.dialogue-content {
    position: absolute;
    left: 4%;
    top: 18%;
    width: 55%;
    height: 69%;
}

.dialogue-panel.is-neutral {
    height: 144px;
    min-height: 144px;
    background-image: url("../../UIBox01.png");
    -unity-slice-scale: 0.32;
}

.dialogue-panel.is-neutral .dialogue-content {
    left: 24px;
    top: 24px;
    right: 24px;
    bottom: 24px;
    width: auto;
    height: auto;
}

.dialogue-body {
    color: rgb(84, 30, 4);
    font-size: 22px;
    white-space: normal;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: upper-left;
}

.dialogue-portrait {
    position: absolute;
    left: 69%;
    top: 20%;
    width: 20%;
    height: 50%;
    visibility: hidden;
    background-image: url("../../PlaceholderPortrait.png");
    -unity-background-scale-mode: scale-to-fit;
}

.dialogue-panel.has-speaker .dialogue-portrait {
    visibility: visible;
}

.dialogue-speaker {
    position: absolute;
    left: 63%;
    top: 77%;
    width: 31%;
    height: 12%;
    margin: 0;
    padding: 0;
    color: rgb(84, 30, 4);
    font-size: 22px;
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dialogue-choices {
    flex-shrink: 0;
}

.dialogue-choice {
    min-height: 32px;
    margin: 6px 4px 0 0;
    padding: 4px 8px;
    white-space: normal;
    font-size: 20px;
    color: rgb(84, 30, 4);
    -unity-text-align: middle-left;
    background-color: rgb(244, 188, 104);
    border-width: 2px;
    border-color: rgb(119, 65, 31);
    border-radius: 0;
}

.dialogue-choice:hover, .dialogue-choice:focus {
    background-color: rgb(255, 211, 139);
    border-color: rgb(79, 39, 19);
}

.dialogue-choice:active {
    background-color: rgb(216, 145, 76);
}

.dialogue-content .unity-scroller--vertical {
    width: 10px;
}

.dialogue-content .unity-base-slider__tracker {
    background-color: rgb(151, 94, 48);
    border-radius: 0;
}

.dialogue-content .unity-base-slider__dragger {
    background-color: rgb(238, 177, 94);
    border-width: 1px;
    border-color: rgb(84, 30, 4);
    border-radius: 0;
}

.dialogue-footer {
    height: 40px;
    min-height: 40px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.dialogue-emotion {
    margin: 0 10px 0 0;
    color: rgb(244, 188, 104);
    font-size: 18px;
}

.dialogue-hint {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 8px 0 0;
    color: rgb(246, 221, 175);
    font-size: 18px;
    white-space: normal;
}

.dialogue-button {
    min-width: 96px;
    height: 36px;
    flex-shrink: 0;
    margin: 0;
    padding: 2px 12px;
    font-size: 20px;
    color: rgb(84, 30, 4);
    background-color: rgb(244, 188, 104);
    border-width: 2px;
    border-color: rgb(119, 65, 31);
    border-radius: 0;
}

.dialogue-button:hover, .dialogue-button:focus {
    background-color: rgb(255, 211, 139);
    border-color: rgb(79, 39, 19);
}

.dialogue-button:active {
    background-color: rgb(216, 145, 76);
}
