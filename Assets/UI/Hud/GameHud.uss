.game-hud-host {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.game-hud {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 140px;
}

.quest-notice {
    position: absolute;
    top: 16px;
    left: 25%;
    right: 25%;
    padding: 8px 12px;
    background-color: rgba(32, 30, 24, 0.82);
    border-width: 1px;
    border-color: rgba(238, 226, 193, 0.16);
    border-radius: 6px;
    color: rgb(238, 226, 193);
    font-size: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
    display: none;
}

/* Placed above the interaction target by InteractionPromptPresenter; its left/top is the bottom centre. */
.interaction-prompt {
    position: absolute;
    flex-direction: row;
    align-items: center;
    translate: -50% -100%;
    padding: 3px 6px;
    background-color: rgba(32, 30, 24, 0.82);
    border-width: 1px;
    border-color: rgba(238, 226, 193, 0.16);
    border-radius: 4px;
    display: none;
}

.interaction-prompt__glyphs {
    flex-direction: row;
    align-items: center;
}

.interaction-prompt__glyph {
    margin-right: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

.interaction-prompt__verb {
    color: rgb(238, 226, 193);
    font-size: 14px;
    padding: 0;
    margin: 0;
}
