<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="GameHud.uss" />
    <ui:Template name="Clock" src="../Clock/ClockHud.uxml" />
    <ui:Template name="Stamina" src="../Stamina/StaminaHud.uxml" />
    <ui:VisualElement name="gameHud" class="game-hud" picking-mode="Ignore">
        <ui:Instance template="Clock" picking-mode="Ignore" />
        <ui:Instance template="Stamina" picking-mode="Ignore" />
    </ui:VisualElement>
    <ui:Label name="questNotice" class="quest-notice" picking-mode="Ignore" />
    <ui:VisualElement name="interactionPrompt" class="interaction-prompt" picking-mode="Ignore">
        <ui:VisualElement name="interactionPromptGlyphs" class="interaction-prompt__glyphs" picking-mode="Ignore" />
        <ui:Label name="interactionPromptVerb" class="interaction-prompt__verb" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
