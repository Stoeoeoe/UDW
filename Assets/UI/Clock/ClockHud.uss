.clock-hud-host {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.clock-hud {
    position: absolute;
    top: 16px;
    right: 16px;
    padding: 8px 12px;
    align-items: flex-end;
    background-color: rgba(32, 30, 24, 0.76);
    border-width: 1px;
    border-color: rgba(238, 226, 193, 0.16);
    border-radius: 6px;
    color: rgb(238, 226, 193);
}

.clock-hud-time {
    margin: 0;
    padding: 0;
    font-size: 20px;
    -unity-text-align: middle-right;
}

.clock-hud-date {
    margin: 2px 0 0 0;
    padding: 0;
    font-size: 11px;
    color: rgb(193, 182, 177);
    -unity-text-align: middle-right;
}
