.stamina-hud {
    margin: 6px 0 0 0;
    padding: 8px 12px;
    background-color: rgba(24, 32, 27, 0.76);
    border-width: 1px;
    border-color: rgba(238, 226, 193, 0.16);
    border-radius: 6px;
}

.stamina-hud-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.stamina-hud-caption {
    margin: 0;
    padding: 0;
    color: rgb(190, 193, 177);
    font-size: 10px;
}

.stamina-hud-value {
    margin: 0;
    padding: 0;
    color: rgb(238, 226, 193);
    font-size: 11px;
}

.stamina-hud-meter {
    height: 4px;
    min-height: 4px;
    margin: 6px 0 0 0;
}

.stamina-hud-meter .unity-progress-bar__container {
    height: 4px;
    min-height: 4px;
}

.stamina-hud-meter .unity-progress-bar__background {
    height: 4px;
    border-width: 0;
    border-radius: 2px;
    background-color: rgba(238, 226, 193, 0.12);
}

.stamina-hud-meter .unity-progress-bar__progress {
    margin: 0;
    border-width: 0;
    border-radius: 2px;
    background-color: rgb(137, 169, 116);
}

.stamina-hud-meter .unity-progress-bar__title-container {
    display: none;
}

.stamina-hud--overcharged .unity-progress-bar__progress {
    background-color: rgb(190, 159, 91);
}

.stamina-hud--overcharged .stamina-hud-value {
    color: rgb(221, 194, 135);
}
