        }
      ]
    },
    {
      "id": "bring",
      "journal": "Bring Fabia three broad bean seeds.",
      "objectives": [
        {
          "id": "seeds",
          "kind": "deliver",
          "text": "Bring Fabia 3 broad bean seeds",
          "character": "base:fabia",
          "item": "base:broad_bean_seeds",
          "count": 3,
          "dialogue": "base:fabia_favour_thanks"
        }
      ]
    }
  ],
  "giver": "base:fabia",
  "onComplete": "SocialStanding.Increase(\"base:fabia\", 15)\nWallet.AddMoney(50)",
  "start": {
    "when": [
      {
        "on": "newDay"
      }
    ],
    "condition": "SocialStanding.HasMoreThan('base:fabia', 40)"
