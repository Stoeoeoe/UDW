{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project.schema.json",
  "title": "Project",
  "description": "A project file (*.vproj) containing global settings, layer definitions, and entity type definitions.",
  "type": "object",
  "required": [
    "version",
    "name",
    "tileSize",
    "defaultMapWidth",
    "defaultMapHeight"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique project identifier (kebab-case, e.g. 'my-awesome-game')."
    },
    "version": {
      "type": "string",
      "description": "File format version string (e.g. '1.0')."
    },
    "name": {
      "type": "string",
      "description": "Human-readable project name."
    },
    "tileSize": {
      "type": "integer",
      "description": "Tile dimensions in pixels (tiles are square). Applies to all tilesets in the project.",
      "minimum": 1
    },
    "defaultMapWidth": {
      "type": "integer",
      "description": "Default width in tiles for newly created maps.",
      "minimum": 1
    },
    "defaultMapHeight": {
      "type": "integer",
      "description": "Default height in tiles for newly created maps.",
      "minimum": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": { "type": "string" },
        "description": { "type": "string" },
        "created": { "type": "string", "format": "date-time" },
        "modified": { "type": "string", "format": "date-time" }
      }
    },
    "terrainTypes": {
      "type": "array",
      "description": "Project-level terrain type definitions used for autotiling and labeling.",
      "items": { "$ref": "#/$defs/TerrainType" }
    },
    "layerDefinitions": {
      "type": "array",
      "description": "Template layer definitions automatically injected into every map.",
      "items": { "$ref": "#/$defs/LayerDefinition" }
    },
    "entityTypes": {
      "type": "array",
      "description": "Project-level entity type definitions.",
      "items": { "$ref": "#/$defs/EntityType" }
    },
    "tileMetadataDefinitions": {
      "type": "array",
      "description": "Project-level tile metadata definitions shared across all tilesets.",
      "items": { "$ref": "#/$defs/PropertyDefinition" }
    },
    "locationMetadataDefinitions": {
      "type": "array",
      "description": "Project-level location metadata definitions shared by maps (map-level properties).",
      "items": { "$ref": "#/$defs/PropertyDefinition" }
    },
    "gameVariables": {
      "type": "array",
      "description": "Named variables exposed to the Lua sandbox at runtime.",
      "items": { "$ref": "#/$defs/GameVariable" }
    },
    "scriptTables": {
      "type": "array",
      "description": "Reusable table definitions with named fields, referenceable as a type.",
      "items": { "$ref": "#/$defs/ScriptTable" }
    },
    "scriptFunctions": {
      "type": "array",
      "description": "Global functions callable anywhere in the Lua sandbox.",
      "items": { "$ref": "#/$defs/ScriptFunction" }
    },
    "scriptNamespaces": {
      "type": "array",
      "description": "Singleton table-like namespaces (e.g. weather, camera, audio).",
      "items": { "$ref": "#/$defs/ScriptNamespace" }
    },
    "scriptContextTypes": {
      "type": "array",
      "description": "Context types defining the shape of 'self' for script execution contexts.",
      "items": { "$ref": "#/$defs/ScriptContextType" }
    },
    "itemClasses": {
      "type": "array",
      "description": "Project-level item class definitions that add extra typed property schemas to items.",
      "items": { "$ref": "#/$defs/ItemClass" }
    }
  },
  "$defs": {
    "TerrainType": {
      "type": "object",
      "required": ["id", "displayName", "color"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "color": {
          "type": "string",
          "description": "Hex color for editor visualization (e.g. '#4caf50').",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "LayerDefinition": {
      "type": "object",
      "required": ["id", "name", "type", "color", "zIndex"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["tile", "entity", "terrain"]
        },
        "color": {
          "type": "string",
          "description": "Hex color for display in the layer list.",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "zIndex": {
          "type": "integer",
          "description": "Rendering Z-index."
        },
        "icon": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "EntityType": {
      "type": "object",
      "required": [
        "id",
        "category",
        "displayName",
        "placeholderColor",
        "properties"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["object", "trigger", "spawn", "transition", "decoration"]
        },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "group": { "type": "string" },
        "placeholderColor": {
          "type": "string",
          "description": "Hex color for editor rendering when no sprite is set.",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "placeholderIcon": { "type": "string" },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/PropertyDefinition" }
        },
        "defaultSize": {
          "type": "array",
          "description": "Default pixel dimensions [width, height].",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2,
          "maxItems": 2
        },
        "sprite": {
          "type": "object",
          "required": ["path"],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "description": "Relative path to the sprite image asset (e.g. 'assets/hero.png')."
            }
          }
        }
      }
    },
    "PropertyDefinition": {
      "type": "object",
      "required": ["key", "label", "type", "defaultValue", "required"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "int",
            "float",
            "number",
            "boolean",
            "enum",
            "color",
            "vector2",
            "reference"
          ]
        },
        "defaultValue": { "$ref": "#/$defs/PropertyValue" },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "constraints": { "$ref": "#/$defs/PropertyConstraints" }
      }
    },
    "PropertyConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "pattern": { "type": "string", "format": "regex" },
        "options": { "type": "array", "items": { "type": "string" } },
        "referenceType": { "type": "string" }
      }
    },
    "PropertyValue": {
      "description": "A scalar, array, or object property value.",
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "string", "format": "color" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "type": "string" } },
        { "type": "array", "items": { "type": "number" } },
        {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        }
      ]
    },
    "GameVariable": {
      "type": "object",
      "required": ["key", "type", "category", "defaultValue"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "description": "Dotted Lua path used to access this variable at runtime (e.g. 'weather.isRain').",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.]*$"
        },
        "type": {
          "type": "string",
          "enum": ["boolean", "number", "string", "enum", "table"],
          "description": "Runtime value type. 'table' references a ScriptTable definition."
        },
        "category": {
          "type": "string",
          "description": "Editor grouping label (e.g. 'Weather', 'Date', 'Game State')."
        },
        "description": {
          "type": "string",
          "description": "Optional human-readable description shown in the editor."
        },
        "defaultValue": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "number" },
            { "type": "string" }
          ],
          "description": "Default value for primitive types. Ignored when type is 'table'."
        },
        "enumValues": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Allowed values when type is 'enum'."
        },
        "tableId": {
          "type": "string",
          "description": "Reference to a ScriptTable definition when type is 'table'."
        },
        "complexFields": {
          "type": "array",
          "items": { "$ref": "#/$defs/TableField" },
          "description": "Legacy inline field definitions. Use tableId instead for new data."
        }
      }
    },
    "ScriptTable": {
      "type": "object",
      "required": ["id", "name", "fields"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": {
          "type": "string",
          "description": "Table type name (e.g. 'npcData', 'questEntry')."
        },
        "description": { "type": "string" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/TableField" }
        }
      }
    },
    "TableField": {
      "type": "object",
      "required": ["key", "type", "defaultValue"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "description": "Field name within the Lua table.",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
        },
        "type": {
          "type": "string",
          "enum": ["boolean", "number", "string", "enum"],
          "description": "Primitive type of this field."
        },
        "description": { "type": "string" },
        "defaultValue": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "number" },
            { "type": "string" }
          ]
        },
        "enumValues": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Allowed values when type is 'enum'."
        }
      }
    },
    "ScriptParam": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Parameter name."
        },
        "type": {
          "type": "string",
          "enum": ["boolean", "number", "string", "enum", "table", "void"],
          "description": "Parameter type."
        },
        "description": { "type": "string" },
        "enumValues": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Allowed values when type is 'enum'."
        }
      }
    },
    "ScriptFunction": {
      "type": "object",
      "required": ["id", "name", "params", "returnType"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": {
          "type": "string",
          "description": "Lua-callable function name."
        },
        "description": { "type": "string" },
        "params": {
          "type": "array",
          "items": { "$ref": "#/$defs/ScriptParam" }
        },
        "returnType": {
          "type": "string",
          "enum": ["boolean", "number", "string", "enum", "table", "void"],
          "description": "Return type ('void' = no return value)."
        },
        "returnTableId": {
          "type": "string",
          "description": "Reference to a ScriptTable definition when returnType is 'table'."
        }
      }
    },
    "ScriptNamespace": {
      "type": "object",
      "required": ["id", "name", "fields", "functions"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": {
          "type": "string",
          "description": "Lua global name (e.g. 'weather', 'camera')."
        },
        "description": { "type": "string" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/GameVariable" }
        },
        "functions": {
          "type": "array",
          "items": { "$ref": "#/$defs/ScriptFunction" }
        }
      }
    },
    "ScriptContextType": {
      "type": "object",
      "required": ["id", "name", "fields", "functions"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": {
          "type": "string",
          "description": "Context type name (e.g. 'npc', 'cutscene')."
        },
        "description": { "type": "string" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/GameVariable" }
        },
        "functions": {
          "type": "array",
          "items": { "$ref": "#/$defs/ScriptFunction" }
        }
      }
    },
    "ItemClass": {
      "type": "object",
      "required": ["id", "name", "properties"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier (kebab-case, e.g. 'seed', 'weapon').",
          "pattern": "^[a-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "description": "Display name shown in the editor (e.g. 'Seed', 'Weapon')."
        },
        "description": {
          "type": "string",
          "description": "Optional description of what this item class represents."
        },
        "properties": {
          "type": "array",
          "description": "Extra typed property definitions added to items assigned to this class.",
          "items": { "$ref": "#/$defs/PropertyDefinition" }
        }
      }
    }
  }
}
