{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project.schema.json",
  "title": "Project",
  "description": "A project file (project.json) containing global settings, layer definitions, and entity type definitions.",
  "type": "object",
  "required": ["version", "name", "tileSize", "defaultMapWidth", "defaultMapHeight"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "File format version string (e.g. '1.0')."
    },
    "name": {
      "type": "string",
      "description": "Human-readable project name."
    },
    "tileSize": {
      "type": "integer",
      "description": "Tile dimensions in pixels (tiles are square). Applies to all tilesets in the project.",
      "minimum": 1
    },
    "defaultMapWidth": {
      "type": "integer",
      "description": "Default width in tiles for newly created maps.",
      "minimum": 1
    },
    "defaultMapHeight": {
      "type": "integer",
      "description": "Default height in tiles for newly created maps.",
      "minimum": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": { "type": "string" },
        "description": { "type": "string" },
        "created": { "type": "string", "format": "date-time" },
        "modified": { "type": "string", "format": "date-time" }
      }
    },
    "terrainTypes": {
      "type": "array",
      "description": "Project-level terrain type definitions used for autotiling and labeling.",
      "items": { "$ref": "#/$defs/TerrainType" }
    },
    "layerDefinitions": {
      "type": "array",
      "description": "Template layer definitions automatically injected into every map.",
      "items": { "$ref": "#/$defs/LayerDefinition" }
    },
    "entityTypes": {
      "type": "array",
      "description": "Project-level entity type definitions.",
      "items": { "$ref": "#/$defs/EntityType" }
    }
  },
  "$defs": {
    "TerrainType": {
      "type": "object",
      "required": ["id", "displayName", "color"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "color": {
          "type": "string",
          "description": "Hex color for editor visualization (e.g. '#4caf50').",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "LayerDefinition": {
      "type": "object",
      "required": ["id", "name", "type", "color", "zIndex"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["tile", "entity", "terrain"]
        },
        "color": {
          "type": "string",
          "description": "Hex color for display in the layer list.",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "zIndex": {
          "type": "integer",
          "description": "Rendering Z-index."
        },
        "icon": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "EntityType": {
      "type": "object",
      "required": ["id", "category", "displayName", "placeholderColor", "properties"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["object", "trigger", "spawn", "transition", "decoration"]
        },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "group": { "type": "string" },
        "placeholderColor": {
          "type": "string",
          "description": "Hex color for editor rendering when no sprite is set.",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "placeholderIcon": { "type": "string" },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/PropertyDefinition" }
        },
        "defaultSize": {
          "type": "array",
          "description": "Default pixel dimensions [width, height].",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2,
          "maxItems": 2
        },
        "sprite": {
          "type": "object",
          "required": ["path"],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "description": "Relative path to the sprite image asset (e.g. 'assets/hero.png')."
            }
          }
        }
      }
    },
    "PropertyDefinition": {
      "type": "object",
      "required": ["key", "label", "type", "defaultValue", "required"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["string", "int", "float", "number", "boolean", "enum", "color", "vector2", "reference"]
        },
        "defaultValue": { "$ref": "#/$defs/PropertyValue" },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "constraints": { "$ref": "#/$defs/PropertyConstraints" }
      }
    },
    "PropertyConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "pattern": { "type": "string", "format": "regex" },
        "options": { "type": "array", "items": { "type": "string" } },
        "referenceType": { "type": "string" }
      }
    },
    "PropertyValue": {
      "description": "A scalar, array, or object property value.",
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "type": "string" } },
        { "type": "array", "items": { "type": "number" } },
        {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        }
      ]
    }
  }
}
