{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Linear cutscene source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "formatVersion",
    "id",
    "mapId",
    "sequence",
    "allowSkip",
    "onComplete"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "formatVersion": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[^\\s:]+:[^\\s]+$"
    },
    "mapId": {
      "type": "string",
      "pattern": "\\S"
    },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "arguments"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "action": {
            "type": "string",
            "pattern": "\\S"
          },
          "arguments": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "\\S"
                },
                {
                  "type": "number"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y"
                  ],
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "anchor": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "anchor"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "x",
                          "y"
                        ],
                        "properties": {
                          "x": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "y": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      },
                      {
                        "type": "object",
                        "properties": {
                          "anchor": {
                            "type": "string",
                            "pattern": "\\S"
                          }
                        },
                        "required": [
                          "anchor"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "allowSkip": {
      "type": "boolean"
    },
    "onComplete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characterPlacements",
        "steps"
      ],
      "properties": {
        "characterPlacements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "character"
            ],
            "oneOf": [
              {
                "required": [
                  "anchor"
                ]
              },
              {
                "required": [
                  "position"
                ]
              }
            ],
            "properties": {
              "character": {
                "type": "string",
                "pattern": "\\S"
              },
              "facing": {
                "type": "string",
                "enum": ["preserve", "North", "East", "South", "West"]
              },
              "anchor": {
                "type": "string",
                "pattern": "\\S"
              },
              "position": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "action",
              "arguments"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "\\S"
              },
              "action": {
                "type": "string",
                "pattern": "\\S"
              },
              "arguments": {
                "type": "object",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "x",
                        "y"
                      ],
                      "properties": {
                        "x": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "y": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    {
                      "type": "object",
                      "properties": {
                        "anchor": {
                          "type": "string",
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "anchor"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "x",
                              "y"
                            ],
                            "properties": {
                              "x": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "y": {
                                "type": "integer",
                                "minimum": 0
                              }
                            }
                          },
                          {
                            "type": "object",
                            "properties": {
                              "anchor": {
                                "type": "string",
                                "pattern": "\\S"
                              }
                            },
                            "required": [
                              "anchor"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "onStart": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "arguments"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "action": {
            "type": "string",
            "pattern": "\\S"
          },
          "arguments": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "\\S"
                },
                {
                  "type": "number"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y"
                  ],
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "anchor": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "anchor"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "x",
                          "y"
                        ],
                        "properties": {
                          "x": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "y": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      },
                      {
                        "type": "object",
                        "properties": {
                          "anchor": {
                            "type": "string",
                            "pattern": "\\S"
                          }
                        },
                        "required": [
                          "anchor"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}