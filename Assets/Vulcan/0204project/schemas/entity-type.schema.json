{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "entity-type.schema.json",
  "title": "Entity Type",
  "description": "A standalone entity type definition stored in entities/*.entity.json.",
  "type": "object",
  "required": [
    "id",
    "category",
    "displayName",
    "placeholderColor",
    "properties"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["object", "trigger", "spawn", "transition", "decoration"]
    },
    "displayName": { "type": "string" },
    "description": { "type": "string" },
    "icon": { "type": "string" },
    "group": { "type": "string" },
    "placeholderColor": {
      "type": "string",
      "description": "Hex color for editor rendering when no sprite is set.",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "placeholderIcon": { "type": "string" },
    "properties": {
      "type": "array",
      "items": { "$ref": "#/$defs/PropertyDefinition" }
    },
    "defaultSize": {
      "type": "array",
      "description": "Default pixel dimensions [width, height].",
      "items": { "type": "integer", "minimum": 1 },
      "minItems": 2,
      "maxItems": 2
    },
    "sprite": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Relative path to the sprite image asset."
        }
      }
    },
    "folderPath": {
      "type": "string",
      "description": "Virtual folder path for workspace organization. Empty string or absent = root."
    }
  },
  "$defs": {
    "PropertyDefinition": {
      "type": "object",
      "required": ["key", "label", "type", "defaultValue", "required"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "int",
            "float",
            "number",
            "boolean",
            "enum",
            "color",
            "vector2",
            "reference"
          ]
        },
        "defaultValue": { "$ref": "#/$defs/PropertyValue" },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "constraints": { "$ref": "#/$defs/PropertyConstraints" }
      }
    },
    "PropertyConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "pattern": { "type": "string", "format": "regex" },
        "options": { "type": "array", "items": { "type": "string" } },
        "referenceType": { "type": "string" }
      }
    },
    "PropertyValue": {
      "description": "A scalar, array, or object property value.",
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "string", "format": "color" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "type": "string" } },
        { "type": "array", "items": { "type": "number" } },
        {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        }
      ]
    }
  }
}
