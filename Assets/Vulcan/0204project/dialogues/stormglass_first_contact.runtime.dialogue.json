      "id": "line-1",
      "type": "line",
      "speaker": "base:my_test_char",
      "text": "This is stormglass. It only answers a heartbeat that doesn't belong here.",
      "msgKey": "dlg.base:stormglass_first_contact.01",
      "next": "line-2"
    },
    {
      "id": "line-2",
      "type": "line",
      "speaker": "base:player",
      "text": "Whose heartbeat?",
      "msgKey": "dlg.base:stormglass_first_contact.02",
      "next": "line-3"
    },
    {
      "id": "line-3",
      "type": "line",
      "speaker": "base:my_test_char",
      "text": "Yours. Count the silence after the flash. Whatever happens, I'll still be here.",
      "msgKey": "dlg.base:stormglass_first_contact.03",
      "next": null
    }
