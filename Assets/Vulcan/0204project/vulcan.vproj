{
  "$schema": "../../../Schemas/project.schema.json",
  "version": "1.0",
  "id": "vulcan",
  "name": "0204 Project Tests",
  "tileSize": 16,
  "defaultMapWidth": 32,
  "defaultMapHeight": 32,
  "metadata": {
    "author": "",
    "description": ""
  },
  "terrainTypes": [
    {
      "id": "grass",
      "displayName": "Grass",
      "color": "#30cf58"
    },
    {
      "id": "dirt",
      "displayName": "Dirt",
      "color": "#8b5955"
    },
    {
      "id": "dark_grass",
      "displayName": "Dark Grass",
      "color": "#194805"
    },
    {
      "id": "lakewater",
      "displayName": "Lake Water",
      "color": "#3182ce"
    },
    {
      "id": "sand",
      "displayName": "Sand",
      "color": "#ffdd00"
    }
  ],
  "layerDefinitions": [
    {
      "id": "terrain",
      "name": "Terrain",
      "type": "terrain",
      "zIndex": 0,
      "color": "#983a3a"
    }
  ],
  "tileMetadataDefinitions": [
    {
      "key": "isFarmable",
      "label": "Is Farmable",
      "type": "boolean",
      "defaultValue": false,
      "required": false
    },
    {
      "key": "isFreshwater",
      "label": "Is Freshwater",
      "type": "boolean",
      "required": false,
      "description": "For watering jug",
      "defaultValue": false
    },
    {
      "key": "waterType",
      "label": "Water Type",
      "type": "enum",
      "required": false,
      "defaultValue": "None",
      "constraints": {
        "options": [
          "None",
          "Ocean_1",
          "Lake_1",
          "River_1"
        ]
      }
    }
  ],
  "locationMetadataDefinitions": [
    {
      "key": "swellDirection",
      "label": "Swell Direction (toward)",
      "type": "enum",
      "required": false,
      "defaultValue": "default",
      "constraints": {
        "options": [
          "default",
          "north",
          "northeast",
          "east",
          "southeast",
          "south",
          "southwest",
          "west",
          "northwest"
        ]
      }
    },
    {
      "key": "musicCue",
      "label": "Music Cue",
      "type": "string",
      "required": false,
      "defaultValue": ""
    },
    {
      "key": "musicPreset",
      "label": "Music Preset",
      "type": "string",
      "required": false,
      "defaultValue": ""
    },
    {
      "key": "locationType",
      "label": "Location Type",
      "type": "enum",
      "required": false,
      "defaultValue": "",
      "constraints": {
        "options": [
          "Indoor",
          "Outdoor"
        ]
      }
    },
    {
      "key": "flowDirectionFrom",
      "label": "Flow Direction From",
      "type": "enum",
      "required": true,
      "defaultValue": "top",
      "constraints": {
        "options": [
          "top",
          "right",
          "bottom",
          "left"
        ]
      }
    },
    {
      "key": "flowDirectionEnd",
      "label": "Flow Direction End",
      "type": "enum",
      "required": true,
      "defaultValue": "bottom",
      "constraints": {
        "options": [
          "top",
          "right",
          "bottom",
          "left"
        ]
      }
    }
  ],
  "itemClasses": [
    {
      "id": "seeds",
      "name": "Seed",
      "properties": [
        {
          "key": "numberOfDays",
          "label": "Number of days",
          "type": "int",
          "defaultValue": 0,
          "required": true
        }
      ]
    }
  ],
  "idPrefix": "base",
  "storyValues": [
    {
      "key": "is_rabatentent",
      "type": "boolean",
      "description": ""
    }
  ],
  "emotions": [
    {
      "id": "base:neutral",
      "name": "Neutral",
      "icon": "GiDramaMasks"
    },
    {
      "id": "base:angry",
      "name": "Angry",
      "icon": "GiAngryEyes"
    },
    {
      "id": "base:happy",
      "name": "Happy",
      "icon": "GiSun"
    },
    {
      "id": "base:very_happy",
      "name": "Very Happy",
      "icon": "GiSparkles"
    },
    {
      "id": "base:sad",
      "name": "Sad",
      "icon": "GiHeartDrop"
    },
    {
      "id": "base:embarrassed",
      "name": "Embarrassed",
      "icon": "GiRose"
    },
    {
      "id": "base:flirty",
      "name": "Flirty",
      "icon": "GiHearts"
    },
    {
      "id": "base:frightened",
      "name": "Frightened",
      "icon": "GiGhost"
    },
    {
      "id": "base:scared",
      "name": "Scared",
      "icon": "GiScreaming"
    }
  ]
}