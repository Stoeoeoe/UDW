{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cutscene source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "formatVersion",
    "id",
    "mapId",
    "sequence",
    "allowSkip",
    "onComplete"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "formatVersion": {
      "type": "integer",
      "enum": [2]
    },
    "id": {
      "type": "string",
      "pattern": "^[^\\s:]+:[^\\s]+$"
    },
    "mapId": {
      "type": "string",
      "pattern": "\\S"
    },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/actionStep"
          },
          {
            "$ref": "#/definitions/conditionalStep"
          },
          {
            "$ref": "#/definitions/parallelStep"
          }
        ]
      }
    },
    "allowSkip": {
      "type": "boolean"
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "initialValue"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "type": { "enum": ["boolean", "number", "string", "position", "path", "table", "storyValue"] },
          "nullable": { "type": "boolean" },
          "initialValue": { "$ref": "#/definitions/luaValue" }
        }
      }
    },
    "transition": {
      "type": "object",
      "description": "Enables the shared entrance and exit transition. Timings are configured globally in Unity's CutscenePresentation settings asset.",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "onComplete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["characterPlacements", "steps"],
      "properties": {
        "characterPlacements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["character"],
            "oneOf": [
              {
                "required": ["anchor"]
              },
              {
                "required": ["position"]
              }
            ],
            "properties": {
              "character": {
                "type": "string",
                "pattern": "\\S"
              },
              "facing": {
                "type": "string",
                "enum": ["preserve", "North", "East", "South", "West"]
              },
              "anchor": {
                "type": "string",
                "pattern": "\\S"
              },
              "position": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y"],
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/actionStep"
          }
        }
      }
    },
    "onStart": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/actionStep"
      }
    }
  },
  "definitions": {
    "luaValue": {
      "anyOf": [
        { "type": ["boolean", "number", "string", "null"] },
        { "type": "array", "items": { "$ref": "#/definitions/luaValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/definitions/luaValue" } }
      ]
    },
    "storyValue": {
      "anyOf": [
        { "type": "boolean" },
        { "type": "string" },
        { "type": "number" },
        {
          "type": "object",
          "propertyNames": { "pattern": "\\S" },
          "additionalProperties": { "$ref": "#/definitions/storyValue" }
        }
      ]
    },
    "actionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "arguments"],
      "properties": {
        "argumentVariables": { "type": "object", "additionalProperties": { "type": "string", "pattern": "\\S" } },
        "resultVariables": { "type": "array", "items": { "type": ["string", "null"], "pattern": "\\S" } },
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "action": {
          "type": "string",
          "pattern": "\\S",
          "not": {
            "enum": ["control.if", "control.parallel"]
          }
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "$ref": "#/definitions/luaValue" },
              { "$ref": "#/definitions/storyValue" },
              { "type": "null" },
              { "type": "boolean" },
              {
                "type": "string",
                "pattern": "\\S"
              },
              {
                "type": "number"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y"],
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              {
                "type": "object",
                "properties": {
                  "anchor": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                },
                "required": ["anchor"],
                "additionalProperties": false
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["x", "y"],
                      "properties": {
                        "x": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "y": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    {
                      "type": "object",
                      "properties": {
                        "anchor": {
                          "type": "string",
                          "pattern": "\\S"
                        }
                      },
                      "required": ["anchor"],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "parallelStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "arguments", "tracks"],
      "properties": {
        "id": { "type": "string", "pattern": "\\S" },
        "action": { "enum": ["control.parallel"] },
        "arguments": { "type": "object", "additionalProperties": false, "properties": {} },
        "tracks": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/actionStep" }
          }
        }
      }
    },
    "conditionalStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "arguments", "then", "else"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "action": {
          "enum": ["control.if"]
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["condition"],
          "properties": {
            "condition": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        "then": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/actionStep"
          }
        },
        "else": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/actionStep"
          }
        }
      }
    }
  }
}
