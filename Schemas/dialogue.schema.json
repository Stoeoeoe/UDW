{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dialogue.schema.json",
  "title": "Dialogue",
  "description": "Dialogue source document (*.dialogue.json) using a flat node array.",
  "type": "object",
  "required": [
    "version",
    "id",
    "name",
    "oneShot",
    "startNodeId",
    "tags",
    "createdAt",
    "updatedAt",
    "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*:[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$"
    },
    "name": {
      "type": "string"
    },
    "folderPath": {
      "type": "string"
    },
    "oneShot": {
      "type": "boolean"
    },
    "dialogueTypeId": {
      "type": "string",
      "pattern": "^(?:[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?)?$"
    },
    "startNodeId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DialogueNode"
      }
    }
  },
  "$defs": {
    "DialogueNodeEditorMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branchId": {
          "type": "string",
          "pattern": "^(?:[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?)?$"
        },
        "parentChoiceNodeId": {
          "type": "string",
          "pattern": "^(?:[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?)?$"
        },
        "parentOptionId": {
          "type": "string",
          "pattern": "^(?:[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?)?$"
        },
        "branchOrder": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "DialogueChoiceOption": {
      "type": "object",
      "required": ["id", "text", "msgKey", "targetNodeId"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$"
        },
        "text": {
          "type": "string"
        },
        "msgKey": {
          "type": "string"
        },
        "condition": {
          "type": ["string", "null"]
        },
        "targetNodeId": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$"
        }
      }
    },
    "DialogueNode": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "type", "text", "msgKey"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$"
            },
            "type": {
              "type": "string",
              "const": "line"
            },
            "speaker": {
              "type": "string",
              "pattern": "^(?:[a-z0-9][a-z0-9_-]*:[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?)?$"
            },
            "emotion": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "msgKey": {
              "type": "string"
            },
            "next": {
              "type": ["string", "null"],
              "pattern": "^(?:[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?)?$"
            },
            "editor": {
              "$ref": "#/$defs/DialogueNodeEditorMeta"
            }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "options"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$"
            },
            "type": {
              "type": "string",
              "const": "choice"
            },
            "options": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DialogueChoiceOption"
              }
            },
            "editor": {
              "$ref": "#/$defs/DialogueNodeEditorMeta"
            }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "lua"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$"
            },
            "type": {
              "type": "string",
              "const": "action"
            },
            "lua": {
              "type": "string"
            },
            "next": {
              "type": ["string", "null"],
              "pattern": "^(?:[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?)?$"
            },
            "editor": {
              "$ref": "#/$defs/DialogueNodeEditorMeta"
            }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "targetNodeId"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$"
            },
            "type": {
              "type": "string",
              "const": "jump"
            },
            "targetDialogueId": {
              "type": ["string", "null"],
              "pattern": "^(?:[a-z0-9][a-z0-9_-]*:[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?)?$"
            },
            "targetNodeId": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$"
            },
            "editor": {
              "$ref": "#/$defs/DialogueNodeEditorMeta"
            }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "text"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$"
            },
            "type": {
              "type": "string",
              "const": "comment"
            },
            "text": {
              "type": "string"
            },
            "editor": {
              "$ref": "#/$defs/DialogueNodeEditorMeta"
            }
          }
        },
        {
          "type": "object",
          "required": ["id", "type"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$"
            },
            "type": {
              "type": "string",
              "const": "end"
            },
            "editor": {
              "$ref": "#/$defs/DialogueNodeEditorMeta"
            }
          }
        }
      ]
    }
  }
}
