{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "quest.schema.json",
  "title": "Quest",
  "description": "A story quest (*.quest.json): steps run in order unless a step or objective names its next step, each with objectives the game checks. Texts are in the source language; their message keys are derived from the IDs (quest.<quest>.title, .description, .<step>.journal, .<step>.<objective>.text), and Vulcanus writes the texts to the sibling <name>.i18n.json.",
  "type": "object",
  "required": [
    "formatVersion",
    "id",
    "title",
    "description",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "id": {
      "$ref": "#/definitions/resourceId",
      "description": "Stable identifier for this quest, with a required namespace (for example base:festival_wine)."
    },
    "title": {
      "$ref": "#/definitions/text",
      "description": "Shown in the journal and in notices."
    },
    "description": {
      "$ref": "#/definitions/text",
      "description": "What the quest is about, shown at the top of its journal entry."
    },
    "giver": {
      "$ref": "#/definitions/resourceId",
      "description": "ID of the character who gives the quest. Omit for none."
    },
    "onStart": {
      "$ref": "#/definitions/lua",
      "description": "Lua actions run when the quest starts."
    },
    "onComplete": {
      "$ref": "#/definitions/lua",
      "description": "Lua actions run when the last step is completed."
    },
    "onFail": {
      "$ref": "#/definitions/lua",
      "description": "Lua actions run when the quest fails."
    },
    "start": {
      "type": "object",
      "description": "Starts the quest by itself: when any of the moments comes, the quest starts if it never has and the condition holds. Without it the quest starts only through a Quests.Start action.",
      "required": ["when"],
      "additionalProperties": false,
      "properties": {
        "when": {
          "type": "array",
          "minItems": 1,
          "description": "The moments at which the quest is considered for starting.",
          "items": {
            "$ref": "#/definitions/startMoment"
          }
        },
        "condition": {
          "$ref": "#/definitions/condition",
          "description": "Read-only Lua condition that must hold at the moment. Omit to start at the moment alone."
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "Steps run in this order unless a step or objective has a next; the next begins when the current one completes.",
      "items": {
        "$ref": "#/definitions/step"
      }
    },
    "editorGraph": {
      "$ref": "quest-editor-graph.schema.json",
      "description": "Vulcanus authoring metadata; saving compiles the flow into the steps and lifecycle Lua imported by Unity."
    },
    "folderPath": {
      "type": "string",
      "description": "Virtual folder path for workspace organization. Empty string or absent = root."
    }
  },
  "definitions": {
    "resourceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*:[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$"
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$"
    },
    "text": {
      "type": "string",
      "pattern": "\\S",
      "description": "Text in the source language, translated through its derived message key."
    },
    "condition": {
      "type": "string",
      "pattern": "\\S",
      "description": "Read-only Lua expression, for example GameState.Story.Has('festival_over')."
    },
    "lua": {
      "type": "string",
      "pattern": "\\S",
      "description": "Lua statements, like a dialogue action node."
    },
    "startMoment": {
      "oneOf": [
        {
          "type": "object",
          "description": "When a new game begins. Loading a save does not count.",
          "required": [
            "on"
          ],
          "additionalProperties": false,
          "properties": {
            "on": {
              "enum": ["gameStart"]
            }
          }
        },
        {
          "type": "object",
          "description": "When a new day begins.",
          "required": [
            "on"
          ],
          "additionalProperties": false,
          "properties": {
            "on": {
              "enum": ["newDay"]
            }
          }
        },
        {
          "type": "object",
          "description": "When a season begins.",
          "required": [
            "on"
          ],
          "additionalProperties": false,
          "properties": {
            "on": {
              "enum": ["newSeason"]
            },
            "season": {
              "enum": [
                "spring",
                "summer",
                "autumn",
                "winter"
              ],
              "description": "Only when this season begins. Omit for any."
            }
          }
        },
        {
          "type": "object",
          "description": "At every ten-minute step of the clock. This checks the most often; prefer another moment where one fits.",
          "required": [
            "on"
          ],
          "additionalProperties": false,
          "properties": {
            "on": {
              "enum": ["everyTenMinutes"]
            }
          }
        },
        {
          "type": "object",
          "description": "When the player's favour with a deity changes.",
          "required": [
            "on"
          ],
          "additionalProperties": false,
          "properties": {
            "on": {
              "enum": ["divineFavour"]
            },
            "deity": {
              "$ref": "#/definitions/resourceId",
              "description": "Only this deity's favour. Omit for any."
            },
            "atLeast": {
              "type": "integer",
              "description": "Only once the favour is at least this much. Omit for any."
            }
          }
        },
        {
          "type": "object",
          "description": "When the player enters a map.",
          "required": [
            "on"
          ],
          "additionalProperties": false,
          "properties": {
            "on": {
              "enum": ["locationChanged"]
            },
            "map": {
              "$ref": "#/definitions/resourceId",
              "description": "Only this map. Omit for any."
            }
          }
        }
      ]
    },
    "next": {
      "type": "string",
      "pattern": "^(end|[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?)$",
      "description": "A step ID, or \"end\" to complete the quest."
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "journal",
        "objectives"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/localId"
        },
        "journal": {
          "$ref": "#/definitions/text",
          "description": "Journal text shown when the step begins."
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "description": "The step completes when all objectives without a next are met, or as soon as one with a next is met.",
          "items": {
            "$ref": "#/definitions/objective"
          }
        },
        "deadline": {
          "type": "object",
          "required": [
            "days"
          ],
          "additionalProperties": false,
          "description": "The quest fails if the step isn't completed in time.",
          "properties": {
            "days": {
              "type": "integer",
              "minimum": 0,
              "description": "Days after the step begins; 0 is the same day."
            },
            "at": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "description": "Time of day (HH:MM) on that day. Omit for the end of the day."
            }
          }
        },
        "failWhen": {
          "$ref": "#/definitions/condition",
          "description": "The quest fails while this holds during the step."
        },
        "next": {
          "$ref": "#/definitions/next",
          "description": "Where the quest continues when the step completes without a branching objective. Omit for the following step in the list, or the end after the last."
        },
        "nextIf": {
          "type": "array",
          "description": "Checked in order when the step completes without a branching objective; the first condition that holds decides where the quest continues, before next.",
          "items": {
            "type": "object",
            "required": [
              "condition",
              "next"
            ],
            "additionalProperties": false,
            "properties": {
              "condition": {
                "$ref": "#/definitions/condition"
              },
              "next": {
                "$ref": "#/definitions/next"
              }
            }
          }
        },
        "onComplete": {
          "$ref": "#/definitions/lua",
          "description": "Lua actions run when the step is completed."
        }
      }
    },
    "objective": {
      "oneOf": [
        {
          "type": "object",
          "description": "Talk to a character, optionally playing a quest dialogue instead of their usual one.",
          "required": [
            "id",
            "kind",
            "text",
            "character"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/definitions/localId"
            },
            "kind": {
              "enum": ["talk"]
            },
            "text": {
              "$ref": "#/definitions/text"
            },
            "next": {
              "$ref": "#/definitions/next",
              "description": "Meeting this objective completes the step and continues here, instead of waiting for the others."
            },
            "character": {
              "$ref": "#/definitions/resourceId"
            },
            "dialogue": {
              "$ref": "#/definitions/resourceId"
            }
          }
        },
        {
          "type": "object",
          "description": "Talk to a character while carrying the items, which are taken.",
          "required": [
            "id",
            "kind",
            "text",
            "character",
            "item",
            "count"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/definitions/localId"
            },
            "kind": {
              "enum": ["deliver"]
            },
            "text": {
              "$ref": "#/definitions/text"
            },
            "next": {
              "$ref": "#/definitions/next",
              "description": "Meeting this objective completes the step and continues here, instead of waiting for the others."
            },
            "character": {
              "$ref": "#/definitions/resourceId"
            },
            "item": {
              "$ref": "#/definitions/resourceId"
            },
            "count": {
              "$ref": "#/definitions/count"
            },
            "dialogue": {
              "$ref": "#/definitions/resourceId"
            }
          }
        },
        {
          "type": "object",
          "description": "Carry the items.",
          "required": [
            "id",
            "kind",
            "text",
            "item",
            "count"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/definitions/localId"
            },
            "kind": {
              "enum": ["have"]
            },
            "text": {
              "$ref": "#/definitions/text"
            },
            "next": {
              "$ref": "#/definitions/next",
              "description": "Meeting this objective completes the step and continues here, instead of waiting for the others."
            },
            "item": {
              "$ref": "#/definitions/resourceId"
            },
            "count": {
              "$ref": "#/definitions/count"
            }
          }
        },
        {
          "type": "object",
          "description": "Enter a map, or a trigger area on it.",
          "required": [
            "id",
            "kind",
            "text",
            "map"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/definitions/localId"
            },
            "kind": {
              "enum": ["reach"]
            },
            "text": {
              "$ref": "#/definitions/text"
            },
            "next": {
              "$ref": "#/definitions/next",
              "description": "Meeting this objective completes the step and continues here, instead of waiting for the others."
            },
            "map": {
              "$ref": "#/definitions/resourceId"
            },
            "trigger": {
              "type": "string",
              "pattern": "\\S",
              "description": "ID of a trigger on that map. Omit for anywhere on the map."
            }
          }
        },
        {
          "type": "object",
          "description": "A read-only Lua condition holds.",
          "required": [
            "id",
            "kind",
            "text",
            "condition"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/definitions/localId"
            },
            "kind": {
              "enum": ["condition"]
            },
            "text": {
              "$ref": "#/definitions/text"
            },
            "next": {
              "$ref": "#/definitions/next",
              "description": "Meeting this objective completes the step and continues here, instead of waiting for the others."
            },
            "condition": {
              "$ref": "#/definitions/condition"
            }
          }
        }
      ]
    }
  }
}
