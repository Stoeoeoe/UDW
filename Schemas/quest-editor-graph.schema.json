{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "quest-editor-graph.schema.json",
  "title": "Quest editor graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "position"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "entry",
              "exit",
              "failure",
              "step",
              "action",
              "lua",
              "branch",
              "function",
              "expression"
            ]
          },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          },
          "stepId": { "type": "string" },
          "group": { "type": "boolean" },
          "code": { "type": "string" },
          "method": { "type": "string", "minLength": 1 },
          "arguments": { "type": "object" },
          "expression": { "type": "string" },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "enum": ["string", "number", "boolean", "position", "table", "storyValue"] },
                "nullable": { "type": "boolean" }
              }
            }
          },
          "comment": { "type": "string" },
          "action": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "arguments"],
            "properties": {
              "method": { "type": "string", "minLength": 1 },
              "arguments": { "type": "object" }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "description": "Execution order: from a step, objective, Branch output or script to what runs next.",
            "additionalProperties": false,
            "required": ["id", "source", "target", "sourcePin", "targetPin", "kind"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "source": { "type": "string" },
              "target": { "type": "string" },
              "sourcePin": { "type": "string", "pattern": "^(next|then|else|objective:.+)$" },
              "targetPin": { "const": "in" },
              "kind": { "const": "execution" }
            }
          },
          {
            "type": "object",
            "description": "A value from a read-only node's output to an input of an action, function or Branch.",
            "additionalProperties": false,
            "required": ["id", "source", "target", "sourcePin", "targetPin", "kind"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "source": { "type": "string" },
              "target": { "type": "string" },
              "sourcePin": { "type": "string", "minLength": 1 },
              "targetPin": { "type": "string", "minLength": 1 },
              "kind": { "const": "data" }
            }
          }
        ]
      }
    }
  }
}
