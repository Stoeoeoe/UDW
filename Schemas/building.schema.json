{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "building.schema.json",
  "title": "Building",
  "description": "A building (*.building.json): its floors' plans, roof and chimney, from which its exterior and interiors are composed out of its kit's pieces; see Tools/Vulcanus/app/docs/building-editor.md.",
  "type": "object",
  "required": [
    "formatVersion",
    "id",
    "name",
    "kit",
    "width",
    "depth",
    "scale",
    "floors",
    "roof"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*:[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$",
      "description": "Stable namespaced ID, for example base:farmhouse."
    },
    "name": {
      "type": "string",
      "pattern": "\\S"
    },
    "kit": {
      "type": "string",
      "pattern": "^(?:[a-z0-9][a-z0-9_-]*:[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?)?$",
      "description": "ID of the kit it is built from; empty until one is chosen."
    },
    "width": {
      "type": "integer",
      "minimum": 3,
      "description": "Footprint width in tiles, outer walls included."
    },
    "depth": {
      "type": "integer",
      "minimum": 5,
      "description": "Footprint depth in tiles, outer walls included."
    },
    "scale": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ],
      "description": "Plan columns per column of the front: 2 or 3 make the inside that many times as wide as the outside."
    },
    "floors": {
      "type": "array",
      "minItems": 1,
      "description": "The floors' plans, ground floor first.",
      "items": {
        "$ref": "#/definitions/BuildingFloor"
      }
    },
    "chimney": {
      "type": "object",
      "required": [
        "column"
      ],
      "additionalProperties": false,
      "properties": {
        "column": {
          "type": "integer",
          "minimum": 0,
          "description": "Column of the plan the chimney rises from."
        }
      }
    },
    "roof": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "side-gable",
            "front-gable",
            "cross-gable"
          ]
        }
      }
    },
    "interiorMapId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*:[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$",
      "description": "ID of the map that is this building's interior."
    },
    "folderPath": {
      "type": "string"
    }
  },
  "definitions": {
    "BuildingFloor": {
      "type": "object",
      "required": [
        "innerWalls",
        "rooms",
        "openings"
      ],
      "additionalProperties": false,
      "properties": {
        "innerWalls": {
          "type": "array",
          "description": "Straight runs of wall cells inside the outer walls.",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y",
              "direction",
              "length"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "description": "Column of the first cell."
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "description": "Row of the first cell."
              },
              "direction": {
                "type": "string",
                "enum": [
                  "east",
                  "south"
                ]
              },
              "length": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "rooms": {
          "type": "array",
          "description": "One entry per floor region: the region containing the cell at.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "at",
              "name",
              "floor"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$"
              },
              "at": {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Column of a cell inside the room."
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Row of a cell inside the room."
                  }
                }
              },
              "name": {
                "type": "string",
                "pattern": "\\S"
              },
              "floor": {
                "type": "string",
                "pattern": "^floor_[a-z0-9_]+$",
                "description": "Name of a floor piece in the kit."
              }
            }
          }
        },
        "openings": {
          "type": "array",
          "description": "Doors and windows, each replacing a wall cell. Windows go in the south wall (seen outside) or the north wall (seen inside, on the back wall).",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9_.-]*[a-z0-9_-])?$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "door",
                  "window"
                ]
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "description": "Column of the wall cell."
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "description": "Row of the wall cell."
              },
              "size": {
                "type": "string",
                "enum": [
                  "small",
                  "medium",
                  "large"
                ],
                "description": "A window's size: small is a slit, medium two tiles tall, large as tall as the wall allows."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "window"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "size"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "door"
                      ]
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": [
                      "size"
                    ]
                  }
                }
              }
            ]
          }
        },
        "stairsUp": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false,
          "description": "The cell of the stairs up; the floor above has the stairs down on the same cell.",
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
