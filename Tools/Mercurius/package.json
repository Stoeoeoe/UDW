{
  "name": "mercurius",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frame-driven technical devlog production for Roemer",
  "license": "UNLICENSED",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "playground": "vite",
    "playground:build": "vite build",
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "new-episode": "tsx scripts/new-episode.ts",
    "validate": "tsx scripts/validate-episode.ts",
    "test": "tsx --test scripts/episodes.test.ts",
    "still": "tsx scripts/produce.ts still",
    "render": "tsx scripts/produce.ts render",
    "compositions": "remotion compositions src/index.ts"
  },
  "dependencies": {
    "@mantine/core": "9.8.1",
    "@mantine/hooks": "9.8.1",
    "@remotion/cli": "4.0.544",
    "@remotion/fonts": "4.0.544",
    "@remotion/media": "4.0.544",
    "@remotion/paths": "4.0.544",
    "@remotion/player": "4.0.544",
    "@remotion/shapes": "4.0.544",
    "@remotion/tailwind-v4": "4.0.544",
    "@remotion/transitions": "4.0.544",
    "lucide-react": "1.74.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.544",
    "shiki": "4.6.0",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/gideon-roman": "5.3.0",
    "@fontsource/noto-sans-mono": "5.3.0",
    "@remotion/eslint-config-flat": "4.0.544",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "prettier": "3.8.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
