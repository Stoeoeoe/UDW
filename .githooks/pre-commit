#!/bin/sh
# Cleans staged first-party C# files (removes unused usings) via ReSharper CLT, then re-stages them.
# Enable once per clone: git config core.hooksPath .githooks
# Skip for one commit: SKIP_LINT=1 git commit ...
[ -n "$SKIP_LINT" ] && exit 0

files=$(git diff --cached --name-only --diff-filter=ACM -- 'Assets/*.cs')
[ -z "$files" ] && exit 0

# Refuse to clean files with unstaged edits, so we never stage changes the user didn't intend.
dirty=$(git diff --name-only -- $files)
if [ -n "$dirty" ]; then
  echo "pre-commit: staged files also have unstaged changes; stage or stash them first:"
  echo "$dirty"
  exit 1
fi

dotnet tool restore >/dev/null || exit 1
include=$(echo "$files" | paste -sd';' -)
dotnet tool run jb cleanupcode UrdewValley.sln --profile=PreCommit --include="$include" --no-build --verbosity=ERROR || exit 1

echo "$files" | xargs git add --
